# Base URL of the PISTA Python backend (no trailing slash).
# Leave empty to run PISTA in Demo Mode with sample data.
VITE_API_BASE_URL=

# Force demo mode on/off. When unset, demo mode is on if VITE_API_BASE_URL is empty.
# VITE_DEMO_MODE=true

# Request timeout in milliseconds (chat/quiz generation can be slow).
VITE_API_TIMEOUT_MS=60000
